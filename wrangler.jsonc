{
  "name": "rentre",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./dist",
    // React Router owns the URL space, so an unknown path must still serve index.html and be
    // resolved client-side. Without this, a refresh or direct hit on any route but / returns 404.
    // Do not add a public/_redirects with `/* /index.html 200`: Workers rejects it as an infinite
    // loop (code 100324). The Pages deploy path (see `deploycode`) falls back to index.html by default.
    "not_found_handling": "single-page-application"
  }
}
