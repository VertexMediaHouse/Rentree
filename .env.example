# Rentre — environment template. Copy to .env and fill in. Never commit .env.

# ── Supabase SDK ─────────────────────────────────────────────────────────────
# The publishable key is designed to ship in client code; Row Level Security is the boundary,
# not the key. Copy both from Project Settings -> API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SECRET. Bypasses Row Level Security completely — every API path using it must do its own
# authorization check. Never prefix with VITE_ (that would inline it into the browser bundle).
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (direct Postgres; only needed for SQL migrations via the Supabase CLI) ──
# DATABASE_URL goes through the pooler (port 6543) and is what the app uses at runtime.
# pgbouncer=true is required: Prisma must not use prepared statements through the pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is the direct connection (port 5432). Migrations need it — they take advisory
# locks and run DDL, which the pooler cannot carry.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── API ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Base URL used to build emailed lease and passport links.
PUBLIC_APP_URL=http://localhost:5173

# Signs session tokens. Required in production; a random per-process value is used in dev,
# which means sign-ins do not survive a restart unless this is set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# A sandbox sender only delivers to the address on the Resend account until a domain is verified.
RESEND_API_KEY=
EMAIL_FROM="Rentre <no-reply@rentre.ca>"   # any local-part works on a verified domain

# ── AI phone screening (ElevenLabs) ──────────────────────────────────────────
# Agents and the outbound Twilio number are configured in the ElevenLabs dashboard.
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_REFERENCE_AGENT_ID=
ELEVENLABS_INTERVIEW_AGENT_ID=
# Agent for the in-browser voice assistant (public launcher). GET /api/elevenlabs/token only ever
# mints tokens for the agent ids set here; any other requested id is rejected with 403.
ELEVENLABS_VOICE_AGENT_ID=
# Signing secret for the post-call webhook (ElevenLabs dashboard → agent → post-call webhook).
# Verifies the HMAC on POST /api/webhooks/elevenlabs; the route answers 503 until this is set.
ELEVENLABS_WEBHOOK_SECRET=
# Public agent id for the browser voice assistant, read by the Vite client (not a secret).
# Leave empty to let the server pick from ELEVENLABS_VOICE_AGENT_ID.
VITE_ELEVENLABS_AGENT_ID=

# ── Legacy ───────────────────────────────────────────────────────────────────
# Path to the old JSON store. Only read by scripts/import-db-json.ts when migrating the
# pre-Postgres data across; the running API no longer uses it.
# DB_PATH=server/data/db.json

# Who reviews landlord-written reference questions (approve/reject links are emailed here).
QUESTION_REVIEW_EMAIL=h.kansara106@gmail.com
# Public origin of the API, used to build those approve/reject links.
PUBLIC_API_URL=http://localhost:5000

# ── Document OCR (OCR.space) ─────────────────────────────────────────────────
# Free tier: 25,000 requests/month, 1MB per file, PDF + images. Get a key at
# https://ocr.space/ocrapi. server/lib/ocr.ts answers 503 until this is set.
OCR_API_KEY=
